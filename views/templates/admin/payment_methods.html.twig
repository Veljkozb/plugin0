{#
  Payment methods lista, po izgledu dema (resources/js/admin/PaymentMethodList.jsx, CodeTags.jsx): naslov, pretraga
  levo, ispod nje red filtera sa Clear filters, tabela bez okvira ćelija, kodovi zemalja i valuta kao čipovi (prva
  tri, ostali iza "+N ▾"), prekidač, Edit, straničenje sa "Showing a–b of n". Isključena metoda ostaje u listi,
  cela prigušena.

  Sadržaj je Worldline katalog iz Core-a, pa nema "Add payment method" ni Delete, a prazna tabela ne postoji: samo
  "nema poklapanja" kad filter ništa ne nađe. Umesto demo kolone Order i filtera Type stoje Group i Type (način
  integracije iz Worldline kataloga), jer Core nema redosled metoda. Prazno ograničenje piše "All".

  Kontroler šalje: filter (search, group, country, currency, status, page), query (samo postavljeni parametri), back
  (isto kao query string, za povratak), groups, countries, currencies (kod => naziv), statuses, page (items, total,
  page, last_page, from, to, error), token (_token tekuće adrese).
#}
{% extends '@Modules/plugin0/views/templates/admin/layout.html.twig' %}

{# Kodovi ograničenja kao u demo CodeTags: prva tri, ostali iza dugmeta koje otvara celu listu. #}
{% macro codes(codes, label) %}
{% if codes is empty %}
    <span>All</span>
{% else %}
    <span class="plugin0-codes">
        {% for code in codes|slice(0, 3) %}<span class="plugin0-tag">{{ code }}</span>{% endfor %}
        {% if codes|length > 3 %}
        <button type="button" class="plugin0-tag plugin0-more" aria-expanded="false" aria-label="Show all {{ codes|length }} {{ label }}">+{{ codes|length - 3 }}<span aria-hidden="true">▼</span></button>
        <span class="plugin0-codes-all" hidden>{% for code in codes %}<span>{{ code }}</span>{% endfor %}</span>
        {% endif %}
    </span>
{% endif %}
{% endmacro %}

{% macro filter(id, label, value, choices, placeholder) %}
<div class="col-md-2 form-group mb-md-0">
    <label for="plugin0_{{ id }}">{{ label }}</label>
    <select class="form-control plugin0-filter" id="plugin0_{{ id }}" name="{{ id }}">
        <option value="">{{ placeholder }}</option>
        {% for key, text in choices %}
        <option value="{{ key }}" {{ value == key ? 'selected' }}>{{ text }}</option>
        {% endfor %}
    </select>
</div>
{% endmacro %}

{% block plugin0_content %}
{% import _self as ui %}
<div class="card">
    <div class="card-body p-4 plugin0-page">
        <h1>Payment methods</h1>

        {# GET forma zamenjuje ceo query string, pa _token ide u skriveno polje: PrestaShop ga traži na svakoj admin adresi. #}
        <form method="get" action="{{ path('plugin0_payment_methods') }}" class="mb-4">
            <input type="hidden" name="_token" value="{{ token }}">
            <div class="form-row mb-3">
                <div class="col-md-5 form-group mb-0">
                    <label for="plugin0_search">Search</label>
                    <input type="search" class="form-control" id="plugin0_search" name="search" value="{{ filter.search }}"
                           placeholder="Name or code" maxlength="64">
                </div>
            </div>
            {# Filter valuta pokazuje samo kod, kao u demu; filter zemalja naziv, jer je kod zemlje manje poznat. #}
            {% set currency_codes = {} %}
            {% for code in currencies|keys %}{% set currency_codes = currency_codes|merge({(code): code}) %}{% endfor %}
            <div class="form-row align-items-end">
                {{ ui.filter('currency', 'Currency', filter.currency, currency_codes, 'All currencies') }}
                {{ ui.filter('country', 'Country', filter.country, countries, 'All countries') }}
                {{ ui.filter('group', 'Group', filter.group, groups, 'All groups') }}
                {{ ui.filter('status', 'Status', filter.status, statuses, 'All') }}
                <div class="col-md-4 form-group mb-md-0">
                    <button type="submit" class="btn btn-primary">Apply</button>
                    <a href="{{ path('plugin0_payment_methods') }}" class="btn btn-outline-secondary ml-2{{ query is empty ? ' disabled' }}"
                       {% if query is empty %}aria-disabled="true" tabindex="-1"{% endif %}>Clear filters</a>
                </div>
            </div>
        </form>

        {# Kad Core ne da katalog, lista je prazna zbog greške (poruka je u flash-u), ne zbog filtera. #}
        {% if page.error is not null %}
            <p class="text-muted mb-0">The payment methods could not be loaded.</p>
        {% elseif page.total == 0 %}
            <div class="text-center p-5 border">
                <h4>No payment methods match these filters</h4>
                <a href="{{ path('plugin0_payment_methods') }}" class="btn btn-outline-secondary mt-3">Clear filters</a>
            </div>
        {% elseif page.items is empty %}
            <p class="text-muted mb-0">Page {{ page.page }} is past the last page, of {{ page.total }}.</p>
        {% else %}
            <div class="table-responsive">
                <table class="plugin0-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Code</th>
                            <th scope="col">Group</th>
                            <th scope="col">Type</th>
                            <th scope="col">Currencies</th>
                            <th scope="col">Countries</th>
                            <th scope="col">Active</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for method in page.items %}
                        <tr class="{{ method.enabled ? '' : 'plugin0-off' }}">
                            <td class="{{ method.enabled ? 'font-weight-bold' : '' }}">{{ method.name }}</td>
                            <td class="plugin0-mono">{{ method.product_id }}</td>
                            <td>{{ method.group_label }}</td>
                            <td>{{ method.integration_types|join(', ') }}</td>
                            <td>{{ ui.codes(method.currencies, 'currencies') }}</td>
                            <td>{{ ui.codes(method.countries, 'countries') }}</td>
                            <td>
                                {# Prekidač je sopstvena forma ka sopstvenoj ruti; skriveno polje nosi ciljano stanje. #}
                                <form method="post" action="{{ path('plugin0_payment_method_enable') }}" class="plugin0-enable">
                                    <input type="hidden" name="product_id" value="{{ method.product_id }}">
                                    <input type="hidden" name="enabled" value="{{ method.enabled ? '0' : '1' }}">
                                    <input type="hidden" name="back" value="{{ back }}">
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" id="plugin0_enable_{{ method.product_id }}" {{ method.enabled ? 'checked' }}>
                                        <label class="custom-control-label" for="plugin0_enable_{{ method.product_id }}"><span class="sr-only">{{ method.enabled ? 'Active' : 'Inactive' }}</span></label>
                                    </div>
                                    <noscript><button type="submit" class="btn btn-sm btn-outline-secondary mt-1">{{ method.enabled ? 'Disable' : 'Enable' }}</button></noscript>
                                </form>
                            </td>
                            <td class="text-right">
                                <a href="{{ path('plugin0_payment_method_edit', {productId: method.product_id, back: back}) }}" style="text-decoration: underline; color: #25292e;">Edit</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if page.total > 0 %}
        <nav aria-label="Pages" class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">
                {% if page.from %}Showing {{ page.from }}–{{ page.to }} of {{ page.total }}{% endif %}
            </span>
            <ul class="pagination mb-0">
                <li class="page-item{{ page.page <= 1 ? ' disabled' }}">
                    <a class="page-link" href="{{ path('plugin0_payment_methods', query|merge({page: max(1, min(page.page - 1, page.last_page))})) }}">Previous</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page {{ page.page }} of {{ page.last_page }}</span>
                </li>
                <li class="page-item{{ page.page >= page.last_page ? ' disabled' }}">
                    <a class="page-link" href="{{ path('plugin0_payment_methods', query|merge({page: page.page + 1})) }}">Next</a>
                </li>
            </ul>
        </nav>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Prekidač šalje svoju formu čim se promeni; bez JS-a ostaje dugme iz noscript bloka.
    document.querySelectorAll('.plugin0-enable .custom-control-input').forEach(function (input) {
        input.addEventListener('change', function () {
            this.disabled = true;
            this.form.submit();
        });
    });
    // Promena filtera odmah primenjuje filter, kao u demu; pretraga ide na Enter ili Apply.
    document.querySelectorAll('.plugin0-filter').forEach(function (select) {
        select.addEventListener('change', function () {
            this.form.submit();
        });
    });
    // "+N ▾" otvara celu listu kodova; zatvara je klik van nje ili Escape, kao demo CodeTags.
    document.querySelectorAll('.plugin0-more').forEach(function (button) {
        var list = button.nextElementSibling;
        button.addEventListener('click', function () {
            var open = list.hidden;
            list.hidden = !open;
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    });
    function closeAll(event) {
        document.querySelectorAll('.plugin0-codes-all:not([hidden])').forEach(function (list) {
            if (event.type === 'keydown' || !list.parentNode.contains(event.target)) {
                list.hidden = true;
                list.previousElementSibling.setAttribute('aria-expanded', 'false');
            }
        });
    }
    document.addEventListener('mousedown', closeAll);
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeAll(event);
        }
    });
</script>
{% endblock %}
