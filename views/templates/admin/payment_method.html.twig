{#
  Forma jedne metode plaćanja, po demu (resources/js/admin/PaymentMethodForm.jsx, MultiSelect.jsx): naslov "New payment
  method" ili ime metode, polja jedno ispod drugog istim redom kao tamo (Name, Code, Type, Currencies, Countries,
  Sort order, Active), Save i Cancel koji pita pre odbacivanja izmena. Ista forma za dodavanje i izmenu; pravila
  proverava kontroler (PaymentMethodForm), pa je poruka ispod polja uvek ona sa servera, a unete vrednosti ostaju.

  Valute i zemlje se biraju kao demo MultiSelect: čipovi sa × i jedan select "Add…" koji nudi samo još neizabrane
  kodove; svaki čip nosi skriveno polje currencies[] odnosno countries[].

  Kontroler šalje: id (null pri dodavanju), title, form (name, code, type, currencies, countries, sort_order,
  is_active), errors (poruka po polju), types (value, label, description), currencies i countries (kod => naziv),
  max_sort_order, worldline_products (Worldline ID => naziv, ponuda za Code), back, back_query.
#}
{% extends '@Modules/plugin0/views/templates/admin/layout.html.twig' %}

{% macro text(name, label, value, error, maxlength, extra_class) %}
<div class="form-group plugin0-field">
    <label for="{{ name }}">{{ label }}</label>
    <input type="text" class="form-control{{ extra_class ? ' ' ~ extra_class }}{{ error ? ' is-invalid' }}" id="{{ name }}" name="{{ name }}" value="{{ value }}" maxlength="{{ maxlength }}">
    {% if error %}<div class="invalid-feedback">{{ error }}</div>{% endif %}
</div>
{% endmacro %}

{# Izbor kodova kao demo MultiSelect: čipovi sa ×, pa select koji nudi samo neizabrane. #}
{% macro multiselect(field, label, selected, choices, error) %}
<div class="form-group plugin0-field">
    <label for="{{ field }}_add">{{ label }}</label>
    {% if choices is empty %}
        <p class="text-muted mb-0">The shop has none enabled.</p>
    {% else %}
        <div class="plugin0-tags{{ error ? ' is-invalid' }}" data-field="{{ field }}">
            {% for code in selected %}
            <span class="plugin0-tag" data-code="{{ code }}">{{ code }}<button type="button" aria-label="Remove {{ code }}">×</button><input type="hidden" name="{{ field }}[]" value="{{ code }}"></span>
            {% endfor %}
            <select id="{{ field }}_add" aria-label="Add {{ label|lower }}">
                <option value="">{{ selected|length == choices|length ? 'All selected' : 'Add…' }}</option>
                {# "*" nikad ne stiže na server: JS ga pretvori u čipove svih preostalih kodova. #}
                <option value="*">All {{ label|lower }}</option>
                {% for code, name in choices %}
                <option value="{{ code }}" {{ code in selected ? 'hidden disabled' }}>{{ code }} · {{ name }}</option>
                {% endfor %}
            </select>
        </div>
        {% if error %}<div class="invalid-feedback d-block">{{ error }}</div>{% endif %}
    {% endif %}
</div>
{% endmacro %}

{% block plugin0_content %}
{% import _self as field %}
<div class="card">
    <div class="card-body p-4 plugin0-page">
        <h1>{{ title }}</h1>

        <form method="post" action="{{ id is null ? path('plugin0_payment_method_create') : path('plugin0_payment_method_edit', {id: id}) }}"
              id="plugin0_method_form" novalidate style="max-width: 42rem;">
            <input type="hidden" name="back" value="{{ back }}">

            {{ field.text('name', 'Name', form.name, errors.name|default(''), 255, '') }}

            {# Code: slobodan unos, a pored njega meni sa Worldline proizvodima iz Core-a (ID i naziv) koji upisuje ID u polje. #}
            <div class="form-group plugin0-field">
                <label for="code">Code</label>
                <div class="form-row">
                    <div class="col-sm-5">
                        <input type="text" class="form-control plugin0-mono{{ errors.code is defined ? ' is-invalid' }}" id="code" name="code"
                               value="{{ form.code }}" maxlength="64" autocomplete="off">
                        {% if errors.code is defined %}<div class="invalid-feedback">{{ errors.code }}</div>{% endif %}
                    </div>
                    <div class="col-sm-7">
                        <select class="form-control" id="plugin0_worldline_product" aria-label="Worldline payment product">
                            <option value="">Pick a Worldline product…</option>
                            {% for product_id, product_name in worldline_products %}
                            <option value="{{ product_id }}">{{ product_id }} · {{ product_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <small class="form-text text-muted">Worldline payment product ID. Pick one from the list or type your own.</small>
            </div>

            {# Jedno radio dugme po tipu koji servis nudi, sa rečima servisa pored: šablon ne zna nijedan tip po imenu. #}
            <fieldset class="form-group plugin0-field">
                <legend>Type</legend>
                {% for type in types %}
                <div class="form-check plugin0-radio mb-2">
                    <input type="radio" class="form-check-input{{ errors.type is defined ? ' is-invalid' }}" id="type_{{ type.value }}" name="type" value="{{ type.value }}" {{ form.type == type.value ? 'checked' }}>
                    <label class="form-check-label" for="type_{{ type.value }}">{{ type.label }}<small>{{ type.description }}</small></label>
                </div>
                {% endfor %}
                {% if errors.type is defined %}<div class="invalid-feedback d-block">{{ errors.type }}</div>{% endif %}
            </fieldset>

            {{ field.multiselect('currencies', 'Currencies', form.currencies, currencies, errors.currencies|default('')) }}

            {{ field.multiselect('countries', 'Countries', form.countries, countries, errors.countries|default('')) }}

            <div class="form-group plugin0-field">
                <label for="sort_order">Sort order</label>
                <input type="number" class="form-control plugin0-num{{ errors.sort_order is defined ? ' is-invalid' }}" id="sort_order" name="sort_order"
                       value="{{ form.sort_order }}" min="1" max="{{ max_sort_order }}" step="1" style="max-width: 10rem;">
                {% if errors.sort_order is defined %}<div class="invalid-feedback">{{ errors.sort_order }}</div>{% endif %}
            </div>

            {# Prekidač i reč pored njega, kao demo ActiveSwitch; polje je is_active = 1. #}
            <div class="d-flex align-items-center plugin0-field" style="gap: 0.75rem;">
                <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="is_active" name="is_active" value="1" {{ form.is_active ? 'checked' }}>
                    <label class="custom-control-label" for="is_active"><span class="sr-only">Active</span></label>
                </div>
                <span id="plugin0_active_text">{{ form.is_active ? 'Active' : 'Inactive' }}</span>
            </div>

            <div class="plugin0-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                {# Link, a ne dugme forme: ništa se ne šalje; JS pita samo kad ima izmena, kao u demu. #}
                <a href="{{ path('plugin0_payment_methods', back_query) }}" id="plugin0_cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    (function () {
        var form = document.getElementById('plugin0_method_form');
        var initial = new URLSearchParams(new FormData(form)).toString();

        // Izmenjeno znači različito od onoga što je učitano, ne dirnuto: vrednost vraćena na staru nije izmena.
        document.getElementById('plugin0_cancel').addEventListener('click', function (event) {
            var current = new URLSearchParams(new FormData(form)).toString();
            if (current !== initial && !window.confirm('Discard the changes to this payment method?')) {
                event.preventDefault();
            }
        });

        // Izbor Worldline proizvoda upisuje njegov ID u polje Code; meni se vraća na početnu stavku.
        var product = document.getElementById('plugin0_worldline_product');
        product.addEventListener('change', function () {
            if (product.value !== '') {
                document.getElementById('code').value = product.value;
                product.value = '';
            }
        });

        var active = document.getElementById('is_active');
        active.addEventListener('change', function () {
            document.getElementById('plugin0_active_text').textContent = active.checked ? 'Active' : 'Inactive';
        });

        // Izbor kodova kao demo MultiSelect: select dodaje čip i vraća se na "Add…", × skida čip i vraća kod u select.
        document.querySelectorAll('.plugin0-tags').forEach(function (box) {
            var field = box.dataset.field;
            var select = box.querySelector('select');

            function refreshPlaceholder() {
                var left = select.querySelectorAll('option:not([hidden]):not([value=""]):not([value="*"])').length;
                select.options[0].textContent = left === 0 ? 'All selected' : 'Add…';
                select.disabled = left === 0;
            }

            function remove(tag) {
                var option = select.querySelector('option[value="' + tag.dataset.code + '"]');
                if (option) {
                    option.hidden = false;
                    option.disabled = false;
                }
                tag.remove();
                refreshPlaceholder();
            }

            function add(code) {
                var tag = document.createElement('span');
                tag.className = 'plugin0-tag';
                tag.dataset.code = code;
                tag.textContent = code;
                var button = document.createElement('button');
                button.type = 'button';
                button.setAttribute('aria-label', 'Remove ' + code);
                button.textContent = '×';
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = field + '[]';
                input.value = code;
                tag.appendChild(button);
                tag.appendChild(input);
                box.insertBefore(tag, select);
                var option = select.querySelector('option[value="' + code + '"]');
                option.hidden = true;
                option.disabled = true;
            }

            box.addEventListener('click', function (event) {
                if (event.target.tagName === 'BUTTON') {
                    remove(event.target.parentNode);
                }
            });

            // Jedan kod dodaje jedan čip; "All" dodaje čipove za sve kodove koji još nisu izabrani.
            select.addEventListener('change', function () {
                var code = select.value;
                if (code === '') {
                    return;
                }
                if (code === '*') {
                    select.querySelectorAll('option:not([hidden]):not([value=""]):not([value="*"])').forEach(function (option) {
                        add(option.value);
                    });
                } else {
                    add(code);
                }
                select.value = '';
                refreshPlaceholder();
            });

            refreshPlaceholder();
        });
    })();
</script>
{% endblock %}
