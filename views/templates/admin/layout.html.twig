{#
  Okvir svake stranice plugina, prenet iz demo projekta (resources/js/shared/AdminLayout.jsx):
  bočni meni levo, stranica desno.

  - Configuration je uvek u meniju: na njoj nepovezana prodavnica postaje povezana.
  - Ostale stavke se vide samo kad je prodavnica povezana, kao u demo projektu, istim redom kao tamo.
  - Odjava i email iz dna demo menija nisu ovde, jer ih PrestaShop admin već ima u gornjoj traci.

  Kontroler šalje: current_page ('configuration', 'payment_methods', 'settings' ili 'logs') i connected (true/false).
#}
{% extends '@PrestaShop/Admin/layout.html.twig' %}

{#
  Stil stranica je u views/css/admin.css; asset('../modules/...') je način na koji PrestaShop moduli (npr.
  blockwishlist) učitavaju svoje fajlove sa Symfony admin stranica: putanja je relativna na admin folder.
#}
{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('../modules/plugin0/views/css/admin.css') }}">
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-3 col-xl-2 mb-3">
        <div class="card">
            <h3 class="card-header">Worldline</h3>
            <nav class="list-group list-group-flush" aria-label="Worldline">
                <a href="{{ path('plugin0_configuration') }}"
                   class="list-group-item list-group-item-action{{ current_page == 'configuration' ? ' active' }}"
                   {% if current_page == 'configuration' %}aria-current="page"{% endif %}>Configuration</a>
                {% if connected %}
                <a href="{{ path('plugin0_payment_methods') }}"
                   class="list-group-item list-group-item-action{{ current_page == 'payment_methods' ? ' active' }}"
                   {% if current_page == 'payment_methods' %}aria-current="page"{% endif %}>Payment methods</a>
                <a href="{{ path('plugin0_settings') }}"
                   class="list-group-item list-group-item-action{{ current_page == 'settings' ? ' active' }}"
                   {% if current_page == 'settings' %}aria-current="page"{% endif %}>Settings</a>
                <a href="{{ path('plugin0_logs') }}"
                   class="list-group-item list-group-item-action{{ current_page == 'logs' ? ' active' }}"
                   {% if current_page == 'logs' %}aria-current="page"{% endif %}>Logs</a>
                {% endif %}
            </nav>
        </div>
    </div>

    <div class="col-lg-9 col-xl-10">
        {% block plugin0_content %}{% endblock %}
    </div>
</div>
{% endblock %}
